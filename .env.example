# docker-compose.yml 에서는 prod 로 덮어씀 (/docs 숨김)
APP_ENV=local
# 로컬 개발용. docker-compose.yml(배포)에서는 db:5432 + POSTGRES_* 로 자동 덮어씀
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5433/miroyiro

# 배포(docker-compose.yml) 전용 — Postgres 계정. 비밀번호는 영숫자만 (@ : / % 쓰면 DATABASE_URL 깨짐)
POSTGRES_USER=scrap
POSTGRES_PASSWORD=change-me-alnum-only
# sc 포트(8000)를 열 주소. 기본 127.0.0.1(미니PC 안에서만).
# backend 가 Tailscale 로 /internal/* 를 불러야 하면 미니PC Tailscale IP(100.x.y.z). 0.0.0.0 금지
BIND_ADDR=127.0.0.1

# 받는 키: backend → scrap (/internal/*) 호출 시 X-Internal-Key
INTERNAL_KEY=dev-internal-key
# 보내는 키: scrap → backend (/internal/*) 호출 시 X-Internal-Key (받는 키와 다른 값)
BACKEND_INTERNAL_KEY=dev-backend-key
# Spring 기본 포트. 운영: Tailscale 주소 (예: http://100.x.y.z:8080)
BACKEND_INTERNAL_URL=http://localhost:8080
KOPIS_API_KEY=
TMDB_API_KEY=
X_BEARER_TOKEN=

# 수집 (자체 UA, 다른 봇 위장 금지)
SCRAPER_USER_AGENT=MiroyiroBot/0.1 (+https://github.com/<org>/miroyiro-scrap)
# 로컬은 false. docker-compose.yml 에서는 true 로 덮어씀
SCHEDULER_ENABLED=false
PLAYWRIGHT_ENABLED=false
