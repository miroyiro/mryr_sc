# 공개용 프록시 (Tailscale Funnel → 127.0.0.1:${PROXY_PORT} → 이 컨테이너 :8080 → sc:8000)
# 허용: /admin, /admin/*, /health 만. 그 외 전부(특히 /internal/*, /docs) 404.
# 바꾸면 tests/test_deploy_config.py 도 같이 확인. 적용: docker compose restart proxy

{
	# Caddy 관리 API(:2019) 끔 → 컨테이너 안에서 설정을 바꿀 통로 제거
	admin off
	# TLS 는 Tailscale Funnel 이 담당. Caddy 는 평문 HTTP 만
	auto_https off
}

:8080 {
	# path 매처는 경로를 정리(.. · %2e 해석)한 뒤 비교한다고 알고 있음 → /admin/../internal 우회 차단
	# (미검증: 배포 후 보고서의 curl --path-as-is 명령으로 404 확인)
	@allowed path /admin /admin/* /health
	handle @allowed {
		reverse_proxy sc:8000
	}
	handle {
		respond 404
	}
}
